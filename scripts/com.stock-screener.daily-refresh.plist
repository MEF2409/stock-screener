<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stock-screener.daily-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/masonferguson/stock-screener/.venv/bin/python</string>
        <string>/Users/masonferguson/stock-screener/scripts/daily_refresh.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/masonferguson/stock-screener</string>

    <!-- Run weekdays at 4:15pm ET (after market close). Adjust hour for your timezone. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>16</integer>
            <key>Minute</key><integer>15</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/masonferguson/stock-screener/results/refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/masonferguson/stock-screener/results/refresh.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
